# ============================================
# DISCORD BOT CONFIGURATION
# ============================================

# Required: Your bot token from Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Required: Your application's client ID
CLIENT_ID=your_application_client_id

# Required: Comma-separated list of guild IDs where commands will be registered
# Example: GUILD_IDS=123456789012345678,987654321098765432
GUILD_IDS=123456789012345678

# ============================================
# AUTHORIZATION & ACCESS CONTROL
# ============================================

# Optional: Role ID required to use bot commands (leave empty for everyone)
COMMAND_ROLE_ID=

# Optional: Your Discord user ID (for /status access)
BOT_OWNER_ID=

# ============================================
# FEATURE-SPECIFIC SETTINGS
# ============================================

# Role ID to ping in /generate command (Community Custom Matches)
ROLE_ID=1204073198837309491

# ============================================
# EXPORT & FILE SETTINGS
# ============================================

# Directory where CSV exports are saved
OUTPUT_DIR=./exports

# Maximum messages to export per channel (0 = unlimited)
DEFAULT_PER_CHANNEL_LIMIT=0

# Maximum messages /repost can send in one invocation
REPOST_MAX_SEND=200

# ============================================
# LOGGING SETTINGS
# ============================================

# Main log file path
LOG_FILE=logs/bot.log

# Error-only log file path
ERROR_LOG_FILE=logs/error.log

# Log level: error, warn, info, debug
LOG_LEVEL=info

# ============================================
# ENVIRONMENT
# ============================================

# Environment mode: development or production
NODE_ENV=production

# ============================================
# WEB DASHBOARD (NEW)
# ============================================

# Port for web dashboard (default: 3000)
WEB_DASHBOARD_PORT=3000

# Dashboard password (CHANGE THIS!)
DASHBOARD_PASSWORD=admin123

# ============================================
# MONGO
# ============================================

MONGODB_URI=mongodb+srv://
